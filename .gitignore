# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter-generated state
.ipynb_checkpoints/

# Local configuration and secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml
.streamlit/secrets.*.toml
**/credentials
**/credentials.*
**/*_credentials.*
**/*_secret.*
**/*.pem
**/*.key

# Logs, temporary files, and editor/OS artifacts
*.log
*.tmp
*.swp
*.swo
~$*
.DS_Store
Thumbs.db
Desktop.ini

# Do not ignore reviewed research outputs, datasets, or model artifacts.
